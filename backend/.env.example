# ============================================================
# .env.example — Konfigurasi Environment Backend PKBM
# ============================================================
# Salin file ini menjadi .env di server VPS Anda:
# cp .env.example .env
# Lalu sesuaikan konfigurasi database dan domain di bawah.
# ============================================================

# Port aplikasi backend Express
PORT=8000
NODE_ENV=production

# Konfigurasi Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=GantiDenganPasswordDatabaseAnda!
DB_NAME=pkbm_bina_mandiri

# Konfigurasi JWT (Ganti dengan string acak yang aman dan panjang)
JWT_SECRET=pkbm_bina_mandiri_super_secret_key_vps_2026_production
JWT_EXPIRES_IN=7d

# Domain Frontend yang diizinkan CORS (pisahkan koma jika lebih dari satu)
FRONTEND_URLS=https://pkbmbinamandiri.sch.id,https://www.pkbmbinamandiri.sch.id