# ============================================================
# .env.example — Contoh Konfigurasi Environment Frontend
# ============================================================
# Salin file ini menjadi .env pada folder frontend:
# cp .env.example .env
#
# Catatan penting:
# Jika frontend dan backend diakses via satu domain (misal: pkbmbinamandiri.sch.id),
# cukup isi: VITE_API_URL=/api
# Jika menggunakan subdomain API terpisah:
# VITE_API_URL=https://api.pkbmbinamandiri.sch.id/api
# ============================================================

VITE_API_URL=/api
