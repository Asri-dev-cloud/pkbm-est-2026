# ============================================================
# .env.production — Konfigurasi Environment Frontend Produksi
# ============================================================
# Gunakan path relatif '/api' agar selalu Same-Origin dengan domain
# website (pkbmbinamandiri.sch.id atau www.pkbmbinamandiri.sch.id).
# Bebas CORS, tanpa kendala preflight, dan kompatibel HTTPS otomatis via proxy Nginx.
VITE_API_URL=/api
