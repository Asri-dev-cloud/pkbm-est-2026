# ============================================================
# .env.production — Konfigurasi Environment Frontend Produksi
# ============================================================
# Opsi 1 (Sangat Disarankan): Jika Nginx melayani frontend di /
# dan meneruskan /api/ serta /uploads/ ke backend (Port 8000),
# gunakan path relatif '/api' (Bebas CORS & kompatibel HTTPS otomatis):
# VITE_API_URL=/api
#
# Opsi 2: Jika backend dipasang pada subdomain terpisah:
VITE_API_URL=https://api.pkbmbinamandiri.sch.id/api
